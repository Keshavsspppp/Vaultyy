# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build output ---
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# --- Generated code ---
# Prisma client is generated on install (postinstall) and before build
/src/generated

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem

# --- Local data (never commit) ---
# SQLite database, WAL/journal files and locally stored uploads
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
/uploads

# --- Tests ---
/coverage
/.test-uploads

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# --- Editors & tooling ---
.vscode/
.idea/
.claude/
.vercel

# --- OS ---
.DS_Store
Thumbs.db
