# --- Required ---
# Configuration is validated when the server starts (src/lib/env.ts): a missing or
# placeholder AUTH_SECRET, or an S3_ENDPOINT that includes the bucket path, stops the boot.
DATABASE_URL="file:./prisma/dev.db"
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true

# --- Optional: Google sign-in (Auth.js Google provider) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials (type: Web application)
# and add this authorized redirect URI:  http://localhost:3000/api/auth/callback/google
# Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional: AI features (Groq) ---
# Get a key at https://console.groq.com/keys. Leave empty to hide all AI features.
GROQ_API_KEY=""
# Model overrides (defaults shown)
# GROQ_PARSE_MODEL="openai/gpt-oss-20b"
# GROQ_REASON_MODEL="openai/gpt-oss-120b"
# GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# Per-user storage quota in bytes (default 1 GiB)
STORAGE_QUOTA_BYTES=1073741824
# Versions kept per file; older non-current versions are pruned beyond this (default 25)
FILE_VERSION_LIMIT=25

# --- Storage: S3-compatible (AWS S3, Cloudflare R2, MinIO) ---
# Leave S3_BUCKET empty to store files on local disk under LOCAL_UPLOAD_DIR instead.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""           # e.g. https://<accountid>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false   # set true for MinIO

# --- Storage: local disk fallback ---
LOCAL_UPLOAD_DIR="./uploads"
